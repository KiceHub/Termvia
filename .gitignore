# Publish only the source release and its required build/legal files.
/*
!/.gitignore
!/LICENSE
!/NOTICE
!/Makefile
!/Package.swift
!/Package.resolved
!/README.md
!/README.zh-CN.md
!/.github/
!/Resources/
!/Sources/
!/scripts/

/Sources/Termvia/Diagnostics/
/Sources/TermviaProbe/
/scripts/*
!/scripts/build-app.sh
!/scripts/build-ppk.sh
!/scripts/install-app.sh
!/scripts/package-release.sh

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml

.DS_Store
__pycache__/
